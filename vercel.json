
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "installCommand": "cd ../.. && npx --yes pnpm@10.26.1 install --no-frozen-lockfile"
    },
    "manocare": {
      "root": "artifacts/manocare",
      "framework": "vite",
      "installCommand": "cd ../.. && npx --yes pnpm@10.26.1 install --no-frozen-lockfile"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "manocare"
      }
    }
  ]
}
